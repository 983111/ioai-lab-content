  "classification_definitions": {
    "Theory": "Understand core concepts and theoretical underpinnings of how AI methods work. Breadth should be prioritized over depth.",
    "Practice": "Develop practical skills to implement AI methods, use library functions, apply methods to data, and interpret outputs.",
    "Both": "Understand theoretical principles and practical application."
  },
  "scope_note": "Topics not listed are considered excluded from the syllabus. Data may include text, tabular data, images, audio, video, and time-series data.",
